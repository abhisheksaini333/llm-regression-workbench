{
  "version": 1,
  "name": "workbench-owned-task-suite",
  "cases": [
    {
      "id": "extract-1",
      "task": "extraction",
      "input": "Return a JSON object with customer and total. Invoice for Ada: total 25.",
      "expected": {
        "customer": "Ada",
        "total": 25
      },
      "slices": [
        "critical",
        "invoices"
      ]
    },
    {
      "id": "schema-1",
      "task": "schema",
      "input": "Return exactly a JSON object with status=\"ok\" and count=1.",
      "expected": {
        "required": [
          "status",
          "count"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "no"
            ]
          },
          "count": {
            "type": "integer"
          }
        },
        "additionalProperties": false
      },
      "slices": [
        "structured"
      ]
    },
    {
      "id": "summary-1",
      "task": "summary",
      "input": "Summarize in fewer than 20 words: The search service was unavailable for ten minutes. Engineers restarted the service. It recovered and monitoring continues.",
      "expected": {
        "keywords": [
          "search",
          "recovered"
        ],
        "max_words": 20,
        "forbidden": [
          "guaranteed",
          "permanent"
        ]
      },
      "slices": [
        "summaries"
      ]
    },
    {
      "id": "tool-1",
      "task": "tool",
      "input": "Available tool: lookup_order(id). Find order 100. Return JSON with tool and arguments.",
      "expected": {
        "tool": "lookup_order",
        "arguments": {
          "id": "100"
        }
      },
      "slices": [
        "critical",
        "tools"
      ]
    },
